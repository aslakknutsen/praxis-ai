  "tooltips": {
    "ingress": {
      "title": "HTTP Listener",
      "description": "Praxis AI proxy entry point (Pingora). All inference traffic enters a single in-process filter pipeline \u2014 no Envoy Wasm shim and no ext_proc round-trips.",
      "details": [
        [
          "Data plane",
          "praxis-ai-proxy"
        ],
        [
          "Protocol",
          "HTTP/1.1, HTTP/2"
        ],
        [
          "Routing",
          "External providers or InferencePool via filters"
        ]
      ],
      "links": [
        [
          "AI Inference docs",
          "../ai-inference.md"
        ],
        [
          "Features",
          "../../features.md"
        ]
      ]
    },
    "f_auth": {
      "title": "auth (planned)",
      "description": "Validates the client API key via MaaS (or equivalent). Injects identity/subscription headers for downstream filters. Replaces Kuadrant Authorino as an in-proxy filter.",
      "details": [
        [
          "Status",
          "Coming soon"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Callback",
          "MaaS /internal API key validate"
        ],
        [
          "Error",
          "401 Unauthorized"
        ]
      ]
    },
    "f_rlimit": {
      "title": "rate_limit",
      "description": "Built-in Praxis rate_limit filter. Pre-checks token quota before inference; reports consumed tokens on the response path.",
      "details": [
        [
          "Phase",
          "Request + Response"
        ],
        [
          "Replaces",
          "Kuadrant Limitador Wasm path"
        ],
        [
          "Error",
          "429 Too Many Requests"
        ]
      ],
      "links": [
        [
          "Praxis rate limiting",
          "https://github.com/praxis-proxy/praxis"
        ]
      ]
    },
    "f_rguard": {
      "title": "ai_guardrails (request)",
      "description": "Calls an external content-safety provider (NeMo) to evaluate the request body. Outcomes: pass, block (403), or redact.",
      "details": [
        [
          "Filter",
          "ai_guardrails"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Provider",
          "NeMo Guardrails"
        ]
      ],
      "links": [
        [
          "Proposal #138",
          "../../proposals/00138_external_guardrails.md"
        ]
      ]
    },
    "f_m2h": {
      "title": "model_to_header",
      "description": "Extracts the model field from the JSON body and promotes it to an X-Model header for header-based routing.",
      "details": [
        [
          "Filter",
          "model_to_header"
        ],
        [
          "Header",
          "X-Model"
        ],
        [
          "Phase",
          "Request"
        ]
      ],
      "links": [
        [
          "AI Inference",
          "../ai-inference.md"
        ]
      ]
    },
    "f_resolve": {
      "title": "provider_resolve",
      "description": "Classifier + router facts: map model name to provider cluster or InferencePool. Promotes x-praxis-ai-* headers / filter metadata for branch routing.",
      "details": [
        [
          "Mechanism",
          "classify \u2192 headers \u2192 router"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Outputs",
          "cluster selection facts"
        ]
      ]
    },
    "f_bmth": {
      "title": "base_model_to_header (planned)",
      "description": "Resolves LoRA adapter names to their base model so endpoint_picker can select pods running the correct base model.",
      "details": [
        [
          "Status",
          "Coming soon"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Use case",
          "LoRA \u2192 InferencePool affinity"
        ]
      ]
    },
    "f_at_req": {
      "title": "api_translation (request)",
      "description": "Translates client API format to provider-native (e.g. OpenAI Chat Completions \u2192 Anthropic Messages) via anthropic_* / format filters.",
      "details": [
        [
          "Filters",
          "anthropic_to_openai, format filters"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Example",
          "path /v1/chat/completions \u2192 /v1/messages"
        ]
      ],
      "links": [
        [
          "Anthropic Messages",
          "../../anthropic-messages.md"
        ]
      ]
    },
    "f_cred": {
      "title": "credential_injection",
      "description": "Injects per-cluster provider API credentials and strips client credentials before upstream.",
      "details": [
        [
          "Filter",
          "credential_injection"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Anthropic",
          "x-api-key"
        ],
        [
          "OpenAI",
          "Authorization: Bearer"
        ]
      ]
    },
    "f_epp": {
      "title": "endpoint_picker (planned)",
      "description": "Implements Gateway API Inference Extension selection semantics in-process: score pods (KV cache, queue, affinity) and override the destination endpoint. No ext_proc / external EPP.",
      "details": [
        [
          "Status",
          "Coming soon"
        ],
        [
          "Spec",
          "GIE semantics (not ext_proc wire)"
        ],
        [
          "Phase",
          "Request"
        ],
        [
          "Output",
          "Selected pod / endpoint"
        ]
      ],
      "links": [
        [
          "GIE docs",
          "https://gateway-api-inference-extension.sigs.k8s.io/"
        ]
      ]
    },
    "f_at_resp": {
      "title": "api_translation (response)",
      "description": "Translates provider-native responses back to the client API format (streaming-aware where applicable).",
      "details": [
        [
          "Phase",
          "Response"
        ]
      ]
    },
    "f_resp_guard": {
      "title": "ai_guardrails (response)",
      "description": "Evaluates upstream response content with the external guardrail provider before returning to the client.",
      "details": [
        [
          "Phase",
          "Response"
        ],
        [
          "Filter",
          "ai_guardrails"
        ]
      ]
    },
    "f_token": {
      "title": "token_count",
      "description": "Extracts token usage from inference responses (streaming and non-streaming) into filter metadata.",
      "details": [
        [
          "Filter",
          "token_count"
        ],
        [
          "Metadata",
          "token.input / token.output / token.total"
        ]
      ]
    },
    "f_rl_rep": {
      "title": "rate_limit (report)",
      "description": "Reports consumed tokens from filter metadata back into the rate-limit budget after a successful response.",
      "details": [
        [
          "Phase",
          "Response"
        ],
        [
          "Filter",
          "rate_limit"
        ]
      ]
    },
    "maas": {
      "title": "MaaS API",
      "description": "External control-plane service for API key and subscription validation. Called by the auth filter \u2014 not part of the Praxis data plane.",
      "details": [
        [
          "Role",
          "Key validation callback"
        ],
        [
          "Called by",
          "auth filter"
        ]
      ]
    },
    "anthropic": {
      "title": "Anthropic",
      "description": "External Claude API. Receives requests after api_translation and credential_injection.",
      "details": [
        [
          "Model",
          "claude-haiku-4-5"
        ],
        [
          "API",
          "/v1/messages"
        ],
        [
          "Auth",
          "x-api-key"
        ]
      ]
    },
    "openai": {
      "title": "OpenAI",
      "description": "External OpenAI API. Native Chat Completions / Responses path when no translation is needed.",
      "details": [
        [
          "Model",
          "gpt-4o-mini"
        ]
      ]
    },
    "azure": {
      "title": "Azure OpenAI",
      "description": "Azure OpenAI endpoint cluster."
    },
    "bedrock": {
      "title": "AWS Bedrock",
      "description": "Bedrock OpenAI-compatible endpoint cluster."
    },
    "vertex": {
      "title": "Vertex AI",
      "description": "Google Vertex AI endpoint cluster."
    },
    "sidecar": {
      "title": "Sidecar",
      "description": "llm-d sidecar coordinating prefills/decode for disaggregated serving. Outside Praxis \u2014 Praxis only selects the endpoint."
    },
    "prefill": {
      "title": "Prefill Pod B (vLLM)",
      "description": "Processes the prompt and produces KV cache for decode."
    },
    "decode": {
      "title": "Decode Pod A (vLLM)",
      "description": "Auto-regressive generation using KV cache from prefill via NIXL."
    },
    "nixl": {
      "title": "NIXL",
      "description": "High-speed KV transfer between prefill and decode pods."
    }
  },
